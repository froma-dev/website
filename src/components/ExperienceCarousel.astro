---
import Carousel from '@components/Carousel.astro'
import '@styles/components/ExperienceCarousel.css'
import {type ExperienceAsset} from "../types/Asset";
import Tag from "@components/Tag.astro";
import {getLangFromUrl, useTranslations} from "@i18n/utils";
const {assets, params} = Astro.props
const {title, history, classNames = 'job loading'} = params
const lang = getLangFromUrl(Astro.url)
const translations = useTranslations(lang)

// Sort by startYear ascending so Season 1 = earliest job
const sortedAssets = [...assets].sort((a: ExperienceAsset, b: ExperienceAsset) => a.startYear - b.startYear)
---
<Carousel title={title} classNames={classNames}>
    {sortedAssets.map((experience: ExperienceAsset, index: number) => {
        const seasonNumber = index + 1
        const duration = experience.endYear ? experience.endYear - experience.startYear : new Date().getFullYear() - experience.startYear
        return (
            <a
                    class="asset-link"
                    href={experience.href}
                    aria-label={`${translations('asset.link.arialabel')} ${experience.company}`}>
                <article
                        class=`asset ${experience.classNames}`
                        style={`view-transition-name: ${experience.transitionName}`}
                        data-astro-history={history ?? 'auto'}>
                    <section class="company-info">
                        <div class="thumbnail-wrapper">
                            <img src={experience.thumbnailUrl} alt={`${experience.company} thumbnail`} class="thumbnail" loading="lazy" />
                            <div class="thumbnail-overlay"/>
                            <span class="season-badge">S{seasonNumber}</span>
                        </div>
                        <h3 class="title">{experience.company}</h3>
                    </section>
                    <section class="metadata">
                        <div class="season-info">
                            <span class="season-label">{translations('experience.season.label')} {seasonNumber}</span>
                            <span class="season-divider">·</span>
                            <span class="season-years">{experience.startYear}{experience.endYear ? `–${experience.endYear}` : '–'}</span>
                        </div>
                        <h2 class="role">{experience.title}</h2>
                        <p class="description">{experience.description}</p>
                        <div class="card-tags">
                            <Tag text={`${duration} ${translations('experience.tag.seasons')}`} className="duration"/>
                        </div>
                    </section>
                </article>
            </a>
        )
    })}
</Carousel>
