---
// "Now Streaming" animated badge — inspired by streaming platform live indicators
---
<div class="now-streaming-badge" aria-label="Now streaming">
    <span class="dot" aria-hidden="true"></span>
    <span class="label">Now Streaming</span>
</div>

<style>
    .now-streaming-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.3rem 0.75rem 0.3rem 0.55rem;
        margin-bottom: 0.75rem;
        border-radius: 2rem;
        border: 1px solid hsla(var(--color-accent-primary-values), 0.35);
        background: hsla(var(--color-accent-primary-values), 0.08);
        backdrop-filter: blur(4px);
        width: fit-content;

        .dot {
            width: 0.55rem;
            height: 0.55rem;
            border-radius: 50%;
            background: var(--color-accent-primary);
            flex-shrink: 0;
            animation: pulse-dot 2s ease-in-out infinite;
        }

        .label {
            font-family: 'REM Variable', sans-serif;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--color-accent-primary);
        }
    }

    @keyframes pulse-dot {
        0%, 100% {
            opacity: 1;
            box-shadow: 0 0 0 0 hsla(var(--color-accent-primary-values), 0.5);
        }
        50% {
            opacity: 0.7;
            box-shadow: 0 0 0 5px hsla(var(--color-accent-primary-values), 0);
        }
    }
</style>
